# Road Roughness backend settings.
# Copy this file to .env and edit. Paths are relative to the backend folder.

# ---- server ----
RR_HOST=127.0.0.1
RR_PORT=8000
# Comma-separated list of web origins allowed to call the API, or * for any.
CORS_ORIGINS=*
# true: the backend also serves ../frontend at http://RR_HOST:RR_PORT/
SERVE_FRONTEND=true
FRONTEND_DIR=../frontend

# ---- storage ----
RR_STORAGE=storage
# true: saving a new project deletes the previous one (KMLs, NDWI images, reports)
KEEP_ONLY_LATEST_PROJECT=true

# ---- Google Earth Engine / Sentinel-2 ----
GEE_PROJECT=arctic-hybrid-462806-c9
DEFAULT_CLOUD_PCT=40
NEAREST_SEARCH_DAYS=90
NDWI_WORKERS=4

# ---- optional: Google Map Tiles API key (adds "(API key)" layers to the map) ----
GOOGLE_MAPS_API_KEY=

# ---- defaults for the web form ----
DEFAULT_CHAINAGE_START_KM=0.000
DEFAULT_INTERVAL_M=1.0
DEFAULT_MEDIAN_OFFSET_M=1.0
DEFAULT_LANE_COUNT=4
DEFAULT_LANE_WIDTH_M=3.40
DEFAULT_BIN_KM=0.100
