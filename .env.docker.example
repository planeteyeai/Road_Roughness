# Docker Environment Variables Example
# Copy this to .env and fill in your values

# Google Earth Engine Configuration (REQUIRED)
GEE_PROJECT=your-gee-project-id
GEE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"...","client_email":"..."}

# Server Configuration (Optional - defaults shown)
RR_HOST=0.0.0.0
RR_PORT=8000
CORS_ORIGINS=*

# Frontend Configuration
SERVE_FRONTEND=true
FRONTEND_DIR=../frontend

# Storage Configuration
KEEP_ONLY_LATEST_PROJECT=true

# NDWI/Sentinel-2 Configuration
DEFAULT_CLOUD_PCT=40
NEAREST_SEARCH_DAYS=90
NDWI_WORKERS=4

# Google Maps API Key (Optional)
GOOGLE_MAPS_API_KEY=

# Default Values (Optional)
DEFAULT_CHAINAGE_START_KM=0.000
DEFAULT_INTERVAL_M=1.0
DEFAULT_MEDIAN_OFFSET_M=1.0
DEFAULT_LANE_COUNT=4
DEFAULT_LANE_WIDTH_M=3.40
DEFAULT_BIN_KM=0.100
